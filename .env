# ---------- Copy to .env and edit. Everything here is optional: the app runs with zero keys. ----------

# true  = never call the internet; use built-in mocks for weather/OSRM/Nominatim/LLM/Telegram
# false = try the free live APIs first, fall back to mocks automatically if a call fails
OFFLINE_MODE=false
HTTP_TIMEOUT_SEC=8

# --- Free public APIs (no keys) ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim policy REQUIRES an identifying User-Agent. Put your own contact.
NOMINATIM_USER_AGENT=khamoshi-radar-prototype/0.1 (contact: you@example.com)
# Demo helper: add extra mm of rain to the Open-Meteo 3-day total (the flood polygon is simulated)
WEATHER_DEMO_BOOST_MM=0

# --- LLM for the Coordinator's explanation: auto | gemini | ollama | template ---
# auto = gemini if GEMINI_API_KEY is set, else ollama if reachable, else built-in template
LLM_PROVIDER=auto
# Free key from https://aistudio.google.com/app/apikey (no credit card)
GEMINI_API_KEY=AQ.Ab8RN6JvE08vH3-7Csmyu1m9Tu9s4yc0MM_y9wXdzRYoLQ40eg
GEMINI_MODEL=gemini-2.0-flash
# Local alternative: `ollama pull llama3` then `ollama serve`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Telegram (leave blank to use the built-in Telegram simulator shown in the UI) ---
# Create a bot with @BotFather, send it a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
# Human coordinator chat/channel (receives Approve / Reject buttons)
TELEGRAM_COORDINATOR_CHAT_ID=
# Demo: all "village representative" questions go to this single chat (can be the same as above)
TELEGRAM_VILLAGE_CHAT_ID=

# --- Neighbor verification behaviour ---
MIN_RADIUS_KM=3
MAX_RADIUS_KM=10
MAX_NEIGHBORS_PER_ZONE=2
VERIFY_TIMEOUT_SEC=25
# In mock mode, simulated village reps answer automatically. Set false to answer manually in the UI.
MOCK_AUTO_REPLY=true
